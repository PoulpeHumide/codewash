{
    "name": "eliott-rpg-game",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "postinstall": "node -e \"if (!process.env.ELECTRON_SKIP_BINARY_DOWNLOAD) require('./node_modules/electron/install.js')\"",
        "metrics:complexity": "eslint src --no-warn-ignored --rule \"{\\\"complexity\\\":[\\\"warn\\\",10]}\"",
        "metrics:duplication": "jscpd src --min-tokens 50 --ignore \"**/*.test.js\" --reporters console",
        "preview": "vite preview",
        "electron:dev": "npm run build && electron .",
        "electron:build": "npm run build && electron-builder"
    },
    "dependencies": {
        "lucide-react": "^0.555.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@tailwindcss/postcss": "^4.1.17",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "@vitest/coverage-v8": "^5.1.2",
        "autoprefixer": "^10.4.22",
        "electron": "45.5.0",
        "electron-builder": "26.18.0",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "jscpd": "^4.0.5",
        "jsdom": "^31.0.1",
        "postcss": "^8.5.6",
        "prettier": "3.10.1",
        "vite": "npm:rolldown-vite@7.2.5",
        "vitest": "^5.1.2"
    },
    "overrides": {
        "vite": "npm:rolldown-vite@7.2.5",
        "app-builder-lib": {
            "minimatch": "11.0.1",
            "@electron/universal": {
                "minimatch": "11.0.1",
                "dir-compare": {
                    "minimatch": "3.1.5"
                }
            },
            "@electron/asar": {
                "minimatch": "3.1.5",
                "glob": {
                    "minimatch": "3.1.5"
                }
            },
            "ejs": {
                "jake": {
                    "filelist": {
                        "minimatch": "5.1.9"
                    }
                }
            }
        }
    },
    "build": {
        "appId": "com.leveluprpg.game",
        "productName": "Level Up RPG",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "win": {
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "portable": {
            "artifactName": "LevelUpRPG-Portable.exe"
        }
    },
    "allowScripts": {
        "electron-winstaller@5.4.0": true,
        "electron@45.5.0": true
    }
}
